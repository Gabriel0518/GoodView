# 环境变量模板 —— 复制为 .env 并填入真实值（本地），或在 Railway 面板设置（云端）

# Postgres 连接串。Railway 加 Postgres 插件后自动提供 DATABASE_URL。
DATABASE_URL=postgresql://user:password@host:5432/dbname

# XMP (Nativex/Mobvista) Open API 凭证
XMP_CLIENT_ID=
XMP_CLIENT_SECRET=

# BytePlus DataRangers 凭证
BYTEPLUS_AK=
BYTEPLUS_SK=
BYTEPLUS_APP_ID=653834
BYTEPLUS_IG_AUTH_EVENT=pwa_ins_login_button_click

# 可选：拉取默认天数、货币、拉取间隔（分钟，仅本地 daemon 用）、展示窗口
# PULL_DEFAULT_DAYS=30       # 每次 pull 抓最近 N 天（cron 每日刷新用）
# WINDOW_DAYS=180            # 看板最多显示多少天（库里可累积更多历史）
# CURRENCY=USD
# PULL_INTERVAL_MIN=5

# 飞书多维表格同步（Postgres → Bitable 镜像，供飞书仪表盘）—— 见 FEISHU-SETUP.md
# 不填 FEISHU_APP_TOKEN 则同步整体跳过，pull-all 照常写 Postgres。
# FEISHU_APP_ID=              # 自建应用 App ID
# FEISHU_APP_SECRET=          # 自建应用 App Secret
# FEISHU_APP_TOKEN=           # 目标多维表格(Base)的 app_token
# FEISHU_SYNC_DAYS=30         # 每次只【更新】最近 N 天；窗口外历史保留在飞书、不删（Postgres 保全量）
# FEISHU_MAX_ROWS=19000       # 单表行数安全线（飞书硬限 2 万）；顶到自动裁最旧行腾地方
# FEISHU_CAMPAIGN_GRAIN=campaign   # campaign(按系列,行少,默认) | adset(含广告组,行多)

# AI 解读（Kimi / Moonshot，OpenAI 兼容接口）—— P3
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2-0711-preview
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# 自有后台业务库（阿里云 DMS 只读 SQL 接口）—— IG绑定/成材 改用业务库真实记录，比前端埋点准
# 见 fetch-dms.mjs；token 找后台同学要，只放行 SELECT
DMS_ENDPOINT=https://admin-api-prod.sitin.ai/api/open/aliyun-dms/run
DMS_TOKEN=

# 对外只读数据 API（供其他 AI 通过 HTTP 读库）。见 app/api/data/*
# DATA_API_TOKEN 未配置时接口整体禁用（默认拒绝，不会裸奔）
DATA_API_TOKEN=
# 可选但强烈建议：专用只读角色的连接串（node db/create-readonly-role.mjs 生成）。
# 不配则回退主 DATABASE_URL + READ ONLY 事务；配了则多一层权限保险。
DATA_API_DATABASE_URL=
