# 环境变量模板 —— 复制为 .env 并填入真实值（本地），或在 Railway 面板设置（云端）

# Postgres 连接串。Railway 加 Postgres 插件后自动提供 DATABASE_URL。
DATABASE_URL=postgresql://user:password@host:5432/dbname

# XMP (Nativex/Mobvista) Open API 凭证
XMP_CLIENT_ID=
XMP_CLIENT_SECRET=

# BytePlus DataRangers 凭证
BYTEPLUS_AK=
BYTEPLUS_SK=
BYTEPLUS_APP_ID=653834
BYTEPLUS_IG_AUTH_EVENT=pwa_ins_login_button_click

# 可选：拉取默认天数、货币、拉取间隔（分钟，仅本地 daemon 用）、展示窗口
# PULL_DEFAULT_DAYS=30       # 每次 pull 抓最近 N 天（cron 每日刷新用）
# WINDOW_DAYS=180            # 看板最多显示多少天（库里可累积更多历史）
# CURRENCY=USD
# PULL_INTERVAL_MIN=5

# AI 解读（Kimi / Moonshot，OpenAI 兼容接口）—— P3
# KIMI_API_KEY=
# KIMI_MODEL=kimi-k2-0711-preview
# KIMI_BASE_URL=https://api.moonshot.cn/v1
