{
  "name": "ad-conversion-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7101",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-7101}",
    "db:migrate": "node db/migrate.mjs",
    "pull": "node pull-all.mjs",
    "pull:backfill": "node pull-all.mjs 180",
    "pull:seq": "node fetch-snapshot.mjs && node fetch-funnel.mjs",
    "daemon": "node daemon.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^14.2.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
